   627	    /// @notice The ```_borrow``` function is the internal implementation for borrowing assets
   628	    /// @param _borrowAmount The amount of the Asset Token to borrow
   629	    /// @param _receiver The address to receive the Asset Tokens
   630	    /// @return _sharesAdded The amount of borrow shares the msg.sender will be debited
   631	    function _borrow(uint128 _borrowAmount, address _receiver) internal returns (uint256 _sharesAdded) {
   632	        // Get borrow accounting from storage to save gas
   633	        VaultAccount memory _totalBorrow = totalBorrow;
   634	
   635	        if(_borrowAmount < minimumBorrowAmount){
   636	            revert InsufficientBorrowAmount();
   637	        }
   638	
   639	        //mint fees
   640	        uint256 debtForMint = (_borrowAmount * (LIQ_PRECISION + mintFee) / LIQ_PRECISION);
   641	
   642	        // Check available capital
   643	        uint256 _assetsAvailable = _totalDebtAvailable(_totalBorrow);
   644	        if (_assetsAvailable < debtForMint) {
   645	            revert InsufficientDebtAvailable(_assetsAvailable, debtForMint);
   646	        }
   647	        
   648	        // Calculate the number of shares to add based on the amount to borrow
   649	        _sharesAdded = _totalBorrow.toShares(debtForMint, true);
   650	
   651	        //combine current shares and new shares
   652	        uint256 newTotalShares = _totalBorrow.shares + _sharesAdded;
   653	
   654	        // Effects: Bookkeeping to add shares & amounts to total Borrow accounting
   655	        _totalBorrow.amount += debtForMint.toUint128();
   656	        _totalBorrow.shares = newTotalShares.toUint128();
   657	
   658	        // Effects: write back to storage
   659	        totalBorrow = _totalBorrow;
   660	        _userBorrowShares[msg.sender] += _sharesAdded;
   661	
   662	        uint256 otherFees = debtForMint > _borrowAmount ? debtForMint - _borrowAmount : 0;
   663	        if (otherFees > 0) claimableOtherFees += otherFees;
   664	
   665	        // Interactions
   666	        IResupplyRegistry(registry).mint(_receiver, _borrowAmount);
   667	        
   668	        emit Borrow(msg.sender, _receiver, _borrowAmount, _sharesAdded, otherFees);
   669	    }
