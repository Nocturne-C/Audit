   266	    /// @notice The ```_isSolvent``` function determines if a given borrower is solvent given an exchange rate
   267	    /// @param _borrower The borrower address to check
   268	    /// @param _exchangeRate The exchange rate, i.e. the amount of collateral to buy 1e18 asset
   269	    /// @return Whether borrower is solvent
   270	    function _isSolvent(address _borrower, uint256 _exchangeRate) internal view returns (bool) {
   271	        uint256 _maxLTV = maxLTV;
   272	        if (_maxLTV == 0) return true;
   273	        //must look at borrow shares of current epoch so user helper function
   274	        //user borrow shares should be synced before _isSolvent is called
   275	        uint256 _borrowerAmount = totalBorrow.toAmount(_userBorrowShares[_borrower], true);
   276	        if (_borrowerAmount == 0) return true;
   277	        
   278	        //anything that calls _isSolvent will call _syncUserRedemptions beforehand
   279	        uint256 _collateralAmount = _userCollateralBalance[_borrower];
   280	        if (_collateralAmount == 0) return false;
   281	
   282	        uint256 _ltv = ((_borrowerAmount * _exchangeRate * LTV_PRECISION) / EXCHANGE_PRECISION) / _collateralAmount;
   283	        return _ltv <= _maxLTV;
   284	    }
