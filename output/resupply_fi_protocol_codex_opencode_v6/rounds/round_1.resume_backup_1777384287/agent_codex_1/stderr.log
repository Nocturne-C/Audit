   146	    //calculate and record an account's earnings of the given reward.  if _claimTo is given it will also claim.
   147	    function _calcRewardIntegral(uint256 _epoch, uint256 _currentEpoch, uint256 _index, address _account, address _claimTo) internal{
   148	        RewardType storage reward = rewards[_index];
   149	        address rewardToken = reward.reward_token;
   150	        //skip invalidated rewards
   151	        //if a reward token starts throwing an error, calcRewardIntegral needs a way to exit
   152	        if(rewardToken == address(0)){
   153	           return;
   154	        }
   155	
   156	        //get difference in balance and remaining rewards
   157	        //getReward is unguarded so we use reward_remaining to keep track of how much was actually claimed since last checkpoint
   158	        uint256 bal = IERC20(rewardToken).balanceOf(address(this));
   159	        uint256 remainingRewards = reward.reward_remaining;
   160	        
   161	        //update the global integral but only for the current epoch
   162	        if (_epoch == _currentEpoch && _totalRewardShares() > 0 && bal > remainingRewards) {
   163	            uint256 rewardPerToken = ((bal - remainingRewards) * PRECISION / _totalRewardShares());
   164	            if(rewardPerToken > 0){
   165	                //increase integral
   166	                global_reward_integral[_epoch][rewardToken] += rewardPerToken;
   167	            }else{
   168	                //set balance as current reward_remaining to let dust grow
   169	                bal = remainingRewards;
   170	            }
   171	        }
   172	
   173	        uint256 reward_global = global_reward_integral[_epoch][rewardToken];
   174	
   175	        if(_account != address(0)){
   176	            //update user integrals
   177	            uint userI = reward_integral_for[_epoch][rewardToken][_account];
   178	            if(_claimTo != address(0) || userI < reward_global){
   179	                //_claimTo address non-zero means its a claim 
   180	                // only allow claims if current epoch and if the reward allows it
   181	                if(_epoch == _currentEpoch && _claimTo != address(0) && !reward.is_non_claimable){
   182	                    uint256 receiveable = claimable_reward[rewardToken][_account] + (_userRewardShares(_account) * (reward_global - userI) / PRECISION);
   183	                    if(receiveable > 0){
   184	                        claimable_reward[rewardToken][_account] = 0;
   185	                        IERC20(rewardToken).safeTransfer(_claimTo, receiveable);
   186	                        emit RewardPaid(_account, rewardToken, _claimTo, receiveable);
   187	                        //remove what was claimed from balance
   188	                        bal -= receiveable;
   189	                    }
   190	                }else{
   191	                    claimable_reward[rewardToken][_account] = claimable_reward[rewardToken][_account] + ( _userRewardShares(_account) * (reward_global - userI) / PRECISION);
   192	                }
   193	                reward_integral_for[_epoch][rewardToken][_account] = reward_global;
   194	            }
   195	        }
   196	
   197	
   198	        //update remaining reward so that next claim can properly calculate the balance change
   199	        //claims and tracking new rewards should only happen on current epoch
   200	        if(_epoch == _currentEpoch && bal != remainingRewards){
   201	            reward.reward_remaining = bal;
   202	        }
   203	    }
