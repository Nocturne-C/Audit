   414	    /// @notice The ```previewAddInterest``` function
   415	    /// @return _interestEarned The amount of interest accrued by all borrowers
   416	    /// @return _newCurrentRateInfo The new rate info struct
   417	    /// @return _claimableFees The new total of fees that are claimable
   418	    /// @return _totalBorrow The new total borrow struct
   419	    function previewAddInterest()
   420	        public
   421	        view
   422	        returns (
   423	            uint256 _interestEarned,
   424	            CurrentRateInfo memory _newCurrentRateInfo,
   425	            uint256 _claimableFees,
   426	            VaultAccount memory _totalBorrow
   427	        )
   428	    {
   429	        _newCurrentRateInfo = currentRateInfo;
   430	
   431	        // Write return values
   432	        InterestCalculationResults memory _results = _calculateInterest(_newCurrentRateInfo);
   433	
   434	        if (_results.isInterestUpdated) {
   435	            _interestEarned = _results.interestEarned;
   436	
   437	            _newCurrentRateInfo.ratePerSec = _results.newRate;
   438	            _newCurrentRateInfo.lastShares = _results.newShares;
   439	
   440	            _claimableFees = claimableFees + uint128(_interestEarned);
   441	            _totalBorrow = _results.totalBorrow;
   442	        } else {
   443	            _claimableFees = claimableFees;
   444	            _totalBorrow = totalBorrow;
   445	        }
   446	    }
