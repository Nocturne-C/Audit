   456	    /// @notice The ```_calculateInterest``` function calculates the interest to be accrued and the new interest rate info
   457	    /// @param _currentRateInfo The current rate info
   458	    /// @return _results The results of the interest calculation
   459	    function _calculateInterest(
   460	        CurrentRateInfo memory _currentRateInfo
   461	    ) internal view returns (InterestCalculationResults memory _results) {
   462	        // Short circuit if interest already calculated this block
   463	        if (_currentRateInfo.lastTimestamp < block.timestamp) {
   464	            // Indicate that interest is updated and calculated
   465	            _results.isInterestUpdated = true;
   466	
   467	            // Write return values and use these to save gas
   468	            _results.totalBorrow = totalBorrow;
   469	
   470	            // Time elapsed since last interest update
   471	            uint256 _deltaTime = block.timestamp - _currentRateInfo.lastTimestamp;
   472	
   473	            // Request new interest rate and full utilization rate from the rate calculator
   474	            (_results.newRate, _results.newShares) = IRateCalculator(rateCalculator).getNewRate(
   475	                address(collateral),
   476	                _deltaTime,
   477	                _currentRateInfo.lastShares
   478	            );
   479	
   480	            // Calculate interest accrued
   481	            _results.interestEarned = (_deltaTime * _results.totalBorrow.amount * _results.newRate) / RATE_PRECISION;
   482	
   483	            // Accrue interest (if any) and fees if no overflow
   484	            if (
   485	                _results.interestEarned > 0 &&
   486	                _results.interestEarned + _results.totalBorrow.amount <= type(uint128).max
   487	            ) {
   488	                // Increment totalBorrow by interestEarned
   489	                _results.totalBorrow.amount += uint128(_results.interestEarned);
   490	            }else{
   491	                //reset interest earned
   492	                _results.interestEarned = 0;
   493	            }
   494	        }
   495	    }
   496	
   497	    /// @notice The ```_addInterest``` function is invoked prior to every external function and is used to accrue interest and update interest rate
   498	    /// @dev Can only called once per block
   499	    /// @return _isInterestUpdated True if interest was calculated
   500	    /// @return _interestEarned The amount of interest accrued by all borrowers
   501	    /// @return _currentRateInfo The new rate info struct
   502	    function _addInterest()
   503	        internal
   504	        returns (
   505	            bool _isInterestUpdated,
   506	            uint256 _interestEarned,
   507	            CurrentRateInfo memory _currentRateInfo
   508	        )
   509	    {
   510	        // Pull from storage and set default return values
   511	        _currentRateInfo = currentRateInfo;
   512	
   513	        // Calc interest
   514	        InterestCalculationResults memory _results = _calculateInterest(_currentRateInfo);
   515	
   516	        // Write return values only if interest was updated and calculated
   517	        if (_results.isInterestUpdated) {
   518	            _isInterestUpdated = _results.isInterestUpdated;
   519	            _interestEarned = _results.interestEarned;
   520	
   521	            // emit here so that we have access to the old values
   522	            emit UpdateRate(
   523	                _currentRateInfo.ratePerSec,
   524	                _currentRateInfo.lastShares,
   525	                _results.newRate,
   526	                _results.newShares
   527	            );
   528	            emit AddInterest(_interestEarned, _results.newRate);
   529	
   530	            // overwrite original values
   531	            _currentRateInfo.ratePerSec = _results.newRate;
   532	            _currentRateInfo.lastShares = _results.newShares;
   533	            _currentRateInfo.lastTimestamp = uint64(block.timestamp);
   534	
   535	            // Effects: write to state
   536	            currentRateInfo = _currentRateInfo;
   537	            claimableFees += _interestEarned; //increase claimable fees by interest earned
   538	            totalBorrow = _results.totalBorrow;
   539	        }
   540	    }
