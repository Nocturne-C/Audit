   389	    /// @notice The ```addInterest``` function is a public implementation of _addInterest and allows 3rd parties to trigger interest accrual
   390	    /// @param _returnAccounting Whether to return additional accounting data
   391	    /// @return _interestEarned The amount of interest accrued by all borrowers
   392	    /// @return _currentRateInfo The new rate info struct
   393	    /// @return _claimableFees The new total of fees that are claimable
   394	    /// @return _totalBorrow The new total borrow struct
   395	    function addInterest(
   396	        bool _returnAccounting
   397	    )
   398	        external
   399	        nonReentrant
   400	        returns (
   401	            uint256 _interestEarned,
   402	            CurrentRateInfo memory _currentRateInfo,
   403	            uint256 _claimableFees,
   404	            VaultAccount memory _totalBorrow
   405	        )
   406	    {
   407	        (, _interestEarned, _currentRateInfo) = _addInterest();
