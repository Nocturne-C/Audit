    17	    constructor(
    18	        IAavePool aavePool_,
    19	        IERC20 aave_,
    20	        uint128 reward_
    21	    ) {
    22	        require(address(aavePool_) != address(0), "AAVE_POOL");
    23	        require(address(aave_) != address(0), "AAVE_TOKEN");
    24	        pool = aavePool_;
    25	        aave = aave_;
    26	        REWARD = reward_;
    27	        // infinite approval
    28	        aave.safeIncreaseAllowance(
    29	            address(pool),
    30	            0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    31	        );
    32	    }
    33	
    34	    function setPool(IAavePool pool_, uint128 newReward_) external onlyOwner {
    35	        pool = pool_;
    36	        REWARD = newReward_;
    37	        aave.safeIncreaseAllowance(
    38	            address(pool),
    39	            0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    40	        );
    41	    }
    42	
    43	    function proxyDeposit(
    44	        IERC20 asset,
    45	        address recipient,
    46	        uint128 amount
    47	    ) external {
